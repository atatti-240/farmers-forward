# Farmers Forward - environment configuration
# Copy this file to `.env` in the repo root and fill in the values you need:
#   cp .env.example .env
# The backend loads this file at startup (python-dotenv, from the repo root).
# All keys below are optional in dev - with none set, email delivery is skipped
# and the login OTP is printed to the Flask server log so the flow stays testable.

# --- Resend email (OTP delivery - the only channel) ---------------------------
# RESEND_API_KEY is all that is required for login emails to work. Delivery goes
# over the Resend HTTPS API rather than SMTP, because Render blocks outbound SMTP
# on every port ("Network is unreachable" on both 587 and 465).
# Get a key at https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY=
# Sender address. Defaults to Resend's shared test sender onboarding@resend.dev,
# which needs no domain verification but ONLY delivers to the email address that
# owns the Resend account. To send to any other recipient, verify a domain at
# https://resend.com/domains and set this to an address on it.
RESEND_FROM=

# --- SMTP email (UNUSED - kept only to make a revert easy) --------------------
# Nothing reads these any more; email goes out via Resend above. They are kept so
# SMTP can be restored on a host that permits outbound SMTP (Render does not).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Application secrets ------------------------------------------------------
# SECRET_KEY signs the Flask session cookie. Generate a strong random value in
# production, e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# ADMIN_SECRET_CODE is the hidden staff-access passcode, entered invisibly on the
# public page (triple-click the logo, then type it within 30s -- no input box is
# shown). Defaults to 202611. It is embedded in the frontend bundle, so it is an
# obscurity gate only -- real security is the admin password + OTP. If you change
# it, also change SEQ in frontend/src/pages/PublicHome.jsx.
ADMIN_SECRET_CODE=

# --- Deployment environment ---------------------------------------------------
# Leave unset/development for local dev. Set APP_ENV=production for a real
# deployment: the backend then REFUSES to start unless SECRET_KEY and
# ADMIN_SECRET_CODE are changed from their built-in defaults and COOKIE_SECURE=true.
# APP_ENV=production

# --- Admin login (SET THESE BEFORE THE FIRST BOOT) ----------------------------
# The admin account is seeded on startup ONLY when the admins table is empty.
#
#   * DEFAULT_ADMIN_PASSWORD set   -> that exact password is used.
#   * DEFAULT_ADMIN_PASSWORD blank -> a RANDOM 12-character password is generated
#                                     and printed to the server log exactly once.
#                                     Miss that line and you are locked out.
#
# Because seeding is skipped once the account exists, setting or changing
# DEFAULT_ADMIN_PASSWORD *after* the first boot does NOT update the stored
# password. To rotate it (safe, keeps farms/samples/results/contacts):
#
#     python3 -m backend.reset_admin --yes
#
# Every boot logs an "[admin-auth] startup credential report" block saying which
# of the two cases above is in effect -- check it if a login is rejected.
#
# On Render (or any host with an ephemeral disk) set BOTH of these in the
# dashboard: the SQLite file is wiped on redeploy, so the admin is re-seeded from
# scratch each time and a random password would change on every deploy.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# --- Optional overrides (uncomment to set) -----------------------------------
# Contact details attached to the seeded admin (used for OTP delivery).
# DEFAULT_ADMIN_PHONE=+10000000000
# DEFAULT_ADMIN_EMAIL=admin@farmersforward.org

# Postgres connection URI. Unset falls back to the local SQLite file, which is
# fine for development but is wiped on every deploy on Render's free tier.
# Use Supabase's TRANSACTION POOLER (port 6543), not the direct port 5432:
# gunicorn's workers open a connection per query and would exhaust the cap.
# URL-encode the password if it contains @ : / or ?
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Set to true in production (behind HTTPS) so the session cookie is Secure-only.
# COOKIE_SECURE=false

# Browser origins allowed to call the API with credentials, comma separated.
# Unset falls back to the known-good production + dev origins in config.py, so
# a renamed Render service is fixed here in the dashboard, not in a redeploy.
# ALLOWED_ORIGINS=https://farmers-forward-1.onrender.com,https://farmersforward.org,https://www.farmersforward.org,http://localhost:3000

# Deprecated single-origin form. Still honoured and merged into ALLOWED_ORIGINS
# when set, but prefer ALLOWED_ORIGINS above.
# FRONTEND_ORIGIN=http://localhost:3000
