# Farmers Forward - environment configuration
# Copy this file to `.env` in the repo root and fill in the values you need:
#   cp .env.example .env
# The backend loads this file at startup (python-dotenv, from the repo root).
# SECRET_KEY is required, in dev too: the backend will not boot without it. A
# fresh database also needs DEFAULT_ADMIN_EMAIL, or nobody can log in. All other
# keys are optional in dev - with none set, email delivery is skipped and the
# login OTP is printed to the Flask server log so the flow stays testable.

# --- Resend email (OTP delivery - the only channel) ---------------------------
# RESEND_API_KEY is all that is required for login emails to work. Delivery goes
# over the Resend HTTPS API rather than SMTP, because Render blocks outbound SMTP
# on every port ("Network is unreachable" on both 587 and 465).
# Get a key at https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY=
# Sender address. Defaults to Resend's shared test sender onboarding@resend.dev,
# which needs no domain verification but ONLY delivers to the email address that
# owns the Resend account. To send to any other recipient, verify a domain at
# https://resend.com/domains and set this to an address on it. With more than one
# admin that is required: from the test sender, every other admin's login code
# is refused by Resend and never arrives. The startup admin report warns while
# the test sender is in use.
RESEND_FROM=

# --- SMTP email (UNUSED - kept only to make a revert easy) --------------------
# Nothing reads these any more; email goes out via Resend above. They are kept so
# SMTP can be restored on a host that permits outbound SMTP (Render does not).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Application secrets ------------------------------------------------------
# SECRET_KEY signs the Flask session cookie. REQUIRED: the backend refuses to
# boot if it is unset, shorter than 32 characters, made of fewer than 8 distinct
# characters, or the old public default "dev-insecure-change-me". Use a random
# value, not a phrase (anyone with the passcode can get a signed cookie and try
# to crack it offline). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs every admin out.
SECRET_KEY=
# ADMIN_SECRET_CODE is the hidden staff-access passcode, entered invisibly on the
# public page (triple-click the logo, then type it within 30s -- no input box is
# shown). Defaults to 202611. It is embedded in the frontend bundle, so it is an
# obscurity gate only -- real security is the one-time code emailed to a
# registered admin. If you change it, also change SEQ in
# frontend/src/pages/PublicHome.jsx.
ADMIN_SECRET_CODE=

# --- Deployment environment ---------------------------------------------------
# APP_ENV is read but has no effect: nothing in the backend branches on it, and
# APP_ENV=production does NOT make the backend refuse to start. The SECRET_KEY
# check above applies everywhere; COOKIE_SECURE (below) is set on its own.
# APP_ENV=production

# --- Admin login (SET DEFAULT_ADMIN_EMAIL BEFORE THE FIRST BOOT) --------------
# Login is passwordless: an admin enters their email address and then the 6-digit
# code emailed to it. Each admin is an owner or an admin; owners add, deactivate
# and reactivate everyone else on the Admins page (nobody is ever deleted).
#
# The first owner is seeded on startup ONLY when the admins table is empty (a
# fresh database), from DEFAULT_ADMIN_EMAIL. There is no built-in default: leave
# it unset on a fresh database and no owner exists until you run reset_admin.
# DEFAULT_ADMIN_NAME is that owner's display name (optional; otherwise the part
# of the email before the @).
#
# Because seeding is skipped once any admin exists, setting or changing
# DEFAULT_ADMIN_EMAIL *after* the first boot does NOT change who can log in. To
# restore owner access (creates an active owner with that email, or promotes and
# reactivates the admin who has it; never deletes or demotes anyone, and keeps
# farms/samples/results/contacts):
#
#     python3 -m backend.reset_admin --email you@example.org --yes
#
# Upgrading from the old username/password login: the first boot migrates the
# existing admin to the new table as the owner, keeping its stored email (or
# DEFAULT_ADMIN_EMAIL if that row has none). Its display name is
# DEFAULT_ADMIN_NAME if set, else the old username (e.g. "admin").
# DEFAULT_ADMIN_USERNAME, DEFAULT_ADMIN_PASSWORD and DEFAULT_ADMIN_PHONE are no
# longer read; delete them once that upgrade is deployed.
#
# Every boot logs an "[admin-auth] startup admin report" block naming the
# owner(s) and whether login codes can be emailed -- check it if no code arrives.
#
# On Render (or any host with an ephemeral disk) set DEFAULT_ADMIN_EMAIL in the
# dashboard: without DATABASE_URL the SQLite file is wiped on redeploy, so the
# owner is re-seeded from it each time and admins added since are lost.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_NAME=

# --- Optional overrides (uncomment to set) -----------------------------------
# Login-code throttling, per email address (registered or not, so it reveals
# nothing). Each value must be a whole number in a sensible range, or a boot
# WARNING is logged and the default used. At most one new code is issued per
# OTP_RESEND_COOLDOWN_SECONDS while the last one can still be used;
# faster requests are silently ignored and the code already sent stays valid.
# Once OTP_FAILURE_LIMIT wrong guesses land within OTP_FAILURE_WINDOW_SECONDS,
# no new codes are issued for that email until the window passes, and no email
# gets more than OTP_ISSUE_LIMIT_PER_HOUR codes an hour (so nobody can flood an
# admin's inbox or the shared Resend quota). OTP_GLOBAL_LIMIT_PER_HOUR caps new
# codes across ALL emails, because every request writes a row and a flood of
# random addresses would otherwise fill the database. Each code also expires
# after OTP_TTL_SECONDS (300) and locks after OTP_MAX_ATTEMPTS (3) wrong tries.
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_FAILURE_LIMIT=10
# OTP_FAILURE_WINDOW_SECONDS=3600
# OTP_FAILURE_LIMIT_PER_DAY=30
# OTP_ISSUE_LIMIT_PER_HOUR=5
# OTP_GLOBAL_LIMIT_PER_HOUR=500

# Postgres connection URI. Unset falls back to the local SQLite file, which is
# fine for development but is wiped on every deploy on Render's free tier.
# Use Supabase's TRANSACTION POOLER (port 6543), not the direct port 5432:
# gunicorn's workers open a connection per query and would exhaust the cap.
# URL-encode the password if it contains @ : / or ?
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Set to true in production (behind HTTPS) so the session cookie is Secure-only.
# COOKIE_SECURE=false

# Browser origins allowed to call the API with credentials, comma separated.
# Unset falls back to the known-good production + dev origins in config.py, so
# a renamed Render service is fixed here in the dashboard, not in a redeploy.
# ALLOWED_ORIGINS=https://farmers-forward-1.onrender.com,https://farmersforward.org,https://www.farmersforward.org,http://localhost:3000

# Deprecated single-origin form. Still honoured and merged into ALLOWED_ORIGINS
# when set, but prefer ALLOWED_ORIGINS above.
# FRONTEND_ORIGIN=http://localhost:3000
